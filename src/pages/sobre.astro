---
import { Image } from "astro:assets"
import Base from "../layouts/Base.astro"
import PageHeader from "../components/PageHeader.astro"
import brasao from "../assets/brasao.png"
// O texto vem do vault do Obsidian: content/index.md
import { Content, frontmatter } from "../../content/index.md"
---

<Base title="Sobre" description="Quem somos e por que a Scuderia 49 existe: cultura automotiva com paixão, opinião e cheiro de gasolina.">
  <div class="wrap">
    <PageHeader kicker="Sobre a Scuderia" title={frontmatter.title ?? "Sobre"} />
    <div class="about">
      <Image src={brasao} alt="Brasão da Scuderia 49" width={220} height={220} class="crest" />
      <div class="prose">
        <Content />
      </div>
    </div>
  </div>
</Base>

<style>
  .about {
    max-width: var(--measure);
    margin-inline: auto;
  }
  .crest {
    display: block;
    width: 10rem;
    height: auto;
    margin: -1rem auto 2rem;
    filter: drop-shadow(0 8px 10px rgb(60 40 10 / 0.3));
  }
</style>
