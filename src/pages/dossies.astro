---
import Base from "../layouts/Base.astro"
import PageHeader from "../components/PageHeader.astro"
import { getPosts, dossieNumber, formatDate, readingTime, lead } from "../lib/posts"

const posts = await getPosts()
const byYear = Map.groupBy(posts, (p) => p.data.date.getUTCFullYear())
---

<Base title="Dossiês" description="Todos os dossiês da Scuderia 49, do mais recente ao primeiro.">
  <div class="wrap">
    <PageHeader
      kicker="O arquivo"
      title="Todos os dossiês"
      intro={`${posts.length} ${posts.length === 1 ? "dossiê arquivado" : "dossiês arquivados"} até agora. Do mais novo ao primeiro.`}
    />

    <div class="archive">
      {
        [...byYear].map(([year, list]) => (
          <section aria-labelledby={`ano-${year}`}>
            <h2 id={`ano-${year}`} class="year">
              {year}
            </h2>
            <ol class="list">
              {list.map((p) => (
                <li class="item">
                  <span class="roundel" aria-hidden="true">
                    {dossieNumber(p, posts)}
                  </span>
                  <div class="item-body">
                    <a class="item-title" href={`/posts/${p.id}`}>
                      {p.data.title}
                    </a>
                    <p class="item-lead">{lead(p)}</p>
                    <p class="label">
                      <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time> · {readingTime(p)} min
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .archive {
    max-width: 48rem;
    margin-inline: auto;
  }
  .year {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 3rem;
    line-height: 1;
    color: var(--red);
  }
  .list {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
  }
  .item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.4rem 0;
    border-top: 1.5px dashed var(--rule);
  }
  .item .roundel {
    --size: 3.2rem;
  }
  .item-body p {
    margin: 0;
  }
  .item-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    color: var(--ink);
    text-decoration: none;
  }
  .item-title:hover {
    color: var(--red);
    text-decoration: underline;
  }
  .item-lead {
    margin: 0.4rem 0 0.5rem !important;
    color: var(--ink-soft);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .item .label {
    font-size: 0.7rem;
  }
</style>
