---
import { render } from "astro:content"
import { getImage, Image } from "astro:assets"
import Base from "../../layouts/Base.astro"
import {
  getPosts,
  dossieNumber,
  lead,
  formatDate,
  readingTime,
  visibleTags,
  tagLabel,
  cover,
  kicker,
  type Post,
} from "../../lib/posts"

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, posts, newer: posts[i - 1], older: posts[i + 1] },
  }))
}

interface Props {
  post: Post
  posts: Post[]
  newer?: Post
  older?: Post
}
const { post, posts, newer, older } = Astro.props
const { Content } = await render(post)
const { title, date, imageAlt } = post.data
const image = cover(post)
const number = dossieNumber(post, posts)
const description = lead(post)
const tags = visibleTags(post)

const ogImage =
  image ? (await getImage({ src: image, width: 1200, format: "jpg" })).src : undefined

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  inLanguage: "pt-BR",
  author: { "@type": "Person", name: "Ramon Mantelli" },
  publisher: { "@type": "Organization", name: "Scuderia 49" },
  mainEntityOfPage: new URL(`/posts/${post.id}`, Astro.site).href,
  keywords: tags.join(", "),
}
---

<Base title={title} description={description} image={ogImage} type="article" published={date} jsonLd={jsonLd}>
  <article class="post">
    <header class="post-header wrap">
      <nav class="crumbs label" aria-label="Você está em">
        <a href="/">Início</a> <span aria-hidden="true">/</span> <a href="/dossies">Dossiês</a>
      </nav>
      <div class="post-number">
        <span class="roundel" aria-hidden="true">{number}</span>
      </div>
      <p class="label kicker">
        {kicker(post, number)}
        {tags[0] && <span> · {tagLabel(tags[0])}</span>}
      </p>
      <h1 class="post-title">{title}</h1>
      <p class="label meta">
        Por Ramon Mantelli · <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post)} min de
        leitura
      </p>
      <div class="stripes thin"></div>
    </header>

    {
      image && (
        <figure class="post-cover wrap">
          <Image src={image} alt={imageAlt ?? ""} widths={[640, 1024, 1600]} sizes="(max-width: 64rem) 100vw, 64rem" loading="eager" />
          {imageAlt && <figcaption class="label">{imageAlt}</figcaption>}
        </figure>
      )
    }

    <div class="wrap">
      <div class="prose">
        <Content />
      </div>

      <footer class="post-footer">
        {
          tags.length > 0 && (
            <p class="post-tags">
              <span class="label">Arquivado em</span>
              {tags.map((t) => (
                <a class="stamp" href={`/garagem/${t}`}>
                  {tagLabel(t)}
                </a>
              ))}
            </p>
          )
        }

        <nav class="pager" aria-label="Outros dossiês">
          {
            older ? (
              <a class="pager-link prev" href={`/posts/${older.id}`}>
                <span class="label">← Dossiê anterior</span>
                <span class="pager-title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a class="pager-link next" href={`/posts/${newer.id}`}>
                <span class="label">Próximo dossiê →</span>
                <span class="pager-title">{newer.data.title}</span>
              </a>
            )
          }
        </nav>
      </footer>
    </div>
  </article>
</Base>

<style>
  .post-header {
    max-width: 52rem;
    margin-inline: auto;
    padding-block: 2rem 2.5rem;
    text-align: center;
  }
  .crumbs {
    margin: 0 0 1.8rem;
    font-size: 0.72rem;
  }
  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--red);
  }
  .post-number {
    display: flex;
    justify-content: center;
    margin-bottom: 1.2rem;
  }
  .post-number .roundel {
    --size: clamp(4.5rem, 12vw, 6rem);
  }
  .kicker {
    margin: 0 0 0.6rem;
    color: var(--red-ink);
    font-weight: 600;
  }
  .post-title {
    margin: 0 auto;
    max-width: 48rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 6.5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  .meta {
    margin: 1.2rem 0 1.8rem;
    font-size: 0.74rem;
    letter-spacing: 0.12em;
  }
  .post-header .stripes {
    max-width: 12rem;
    margin-inline: auto;
  }

  .post-cover {
    max-width: 64rem;
    margin: -0.5rem auto 3rem;
  }
  .post-cover img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 36rem;
    object-fit: cover;
    border: 1.5px solid var(--ink);
    box-shadow: 8px 8px 0 var(--rule);
    filter: sepia(0.12) contrast(1.02);
  }
  .post-cover figcaption {
    margin-top: 0.9rem;
    text-align: center;
    font-size: 0.7rem;
  }

  .post-footer {
    max-width: var(--measure);
    margin: 3.5rem auto 0;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 2.5rem;
  }
  .post-tags .label {
    margin-right: 0.3rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1.5px solid var(--ink);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    background: var(--card);
    border: 1.5px solid var(--ink);
    box-shadow: 4px 4px 0 var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .pager-link:hover {
    color: var(--ink);
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--gold);
  }
  .pager-link .label {
    font-size: 0.68rem;
  }
  .pager-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .next {
    text-align: right;
    grid-column: 2;
  }
  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .next {
      grid-column: 1;
    }
  }
</style>
