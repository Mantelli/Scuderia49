---
import { Image } from "astro:assets"
import brasao from "../assets/brasao.png"
import ThemeToggle from "./ThemeToggle.astro"

const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const links = [
  { href: "/", label: "Início" },
  { href: "/dossies", label: "Dossiês" },
  { href: "/garagem", label: "Garagem" },
  { href: "/sobre", label: "Sobre" },
]
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href))
const isHome = path === "/"
---

<header class="masthead">
  <div class="stripes"></div>
  <div class="wrap masthead-inner">
    <a href="/" class="brand" aria-label="Scuderia 49 — página inicial">
      <Image src={brasao} alt="" width={96} height={96} class="brand-logo" loading="eager" />
      <span class="brand-text">
        {isHome ? <h1 class="brand-name">Scuderia 49</h1> : <span class="brand-name">Scuderia 49</span>}
        <span class="brand-tagline">A Garagem Onde as Máquinas Têm Alma</span>
      </span>
    </a>
  </div>
  <nav class="wrap nav" aria-label="Principal">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--rule);
  }
  .masthead-inner {
    display: flex;
    justify-content: center;
    padding-block: clamp(1.2rem, 3vw, 2rem) 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    color: var(--ink);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .brand-logo {
    width: clamp(3.5rem, 9vw, 5.5rem);
    height: auto;
    filter: drop-shadow(0 4px 6px rgb(60 40 10 / 0.25));
    transition: transform 0.25s ease;
  }
  .brand:hover .brand-logo {
    transform: rotate(-4deg) scale(1.03);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .brand-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 7vw, 4rem);
    letter-spacing: 0.01em;
    line-height: 0.95;
  }
  .brand-tagline {
    margin-top: 0.45rem;
    font-family: var(--font-label);
    font-size: clamp(0.62rem, 1.8vw, 0.85rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red-ink);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-top: 3px double var(--rule);
    padding-block: 0.15rem;
  }
  .nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 clamp(0.25rem, 2vw, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: block;
    padding: 0.55rem 0.5rem;
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 0.92rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .nav a:hover {
    color: var(--red);
  }
  .nav a[aria-current="page"] {
    color: var(--red-ink);
    border-bottom-color: var(--red);
  }
  @media (max-width: 30rem) {
    .nav a {
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      padding-inline: 0.3rem;
    }
  }
</style>
