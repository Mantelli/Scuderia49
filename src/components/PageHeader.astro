---
interface Props {
  kicker: string
  title: string
  intro?: string
}
const { kicker, title, intro } = Astro.props
---

<header class="page-header">
  <p class="label">{kicker}</p>
  <h1>{title}</h1>
  {intro && <p class="intro">{intro}</p>}
  <div class="stripes thin"></div>
</header>

<style>
  .page-header {
    max-width: 44rem;
    margin: 0 auto 3rem;
    padding-top: 2.5rem;
    text-align: center;
  }
  .label {
    margin: 0 0 0.5rem;
    color: var(--red-ink);
    font-weight: 600;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 3.8rem);
    line-height: 1.04;
    text-wrap: balance;
  }
  .intro {
    margin: 1rem auto 0;
    font-style: italic;
    color: var(--ink-soft);
  }
  .stripes {
    max-width: 10rem;
    margin: 1.8rem auto 0;
  }
</style>
